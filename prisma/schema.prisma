// Interview Prep – PostgreSQL-backed production schema.
// SQLite migrations are retained under prisma/migrations-sqlite for local
// history, but deployed and current local data use PostgreSQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Models ----------
// String "enum-ish" fields use these constant values (see src/lib/):
//   Company.stage:     APPLIED | PREP | INTERVIEWING | OFFER | REJECTED
//   Question.category: CODING | BEHAVIORAL | SYSTEM_DESIGN | DOMAIN
//   Question.difficulty: EASY | MEDIUM | HARD
//   Question.status:   TODO | PRACTICING | MASTERED

/// A registered user. Passwords are stored as scrypt hashes; sessions store only
/// SHA-256 hashes of the browser token.
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  companies    Company[]
  sessions     Session[]
}

/// A revocable, database-backed login session.
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// A company the user applied to (or plans to prep for). One user => one question set.
model Company {
  id        String     @id @default(cuid())
  /// Nullable so companies created before accounts existed can be adopted by
  /// the first registered account. Ownerless rows are invisible to everyone.
  userId    String?
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  role      String? // the job title you applied for
  stage     String     @default("APPLIED")
  notes     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  questions Question[]

  @@index([userId])
  @@unique([userId, name])
  @@map("companies")
}

/// A single interview question, always owned by one company.
/// The `solution` is intentionally NOT returned by list endpoints:
/// the client only fetches it (GET /api/questions/:id) when the user clicks
/// "Show me the solution".
model Question {
  id         String     @id @default(cuid())
  companyId  String
  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category   String // CODING | BEHAVIORAL | SYSTEM_DESIGN | DOMAIN
  title      String
  prompt     String // full question text / statement
  difficulty String     @default("MEDIUM") // EASY | MEDIUM | HARD
  solution   String // markdown: final solution / approach for "Show me the solution"
  status     String     @default("TODO") // TODO | PRACTICING | MASTERED
  source     String     @default("curated") // "curated" | "openai" | "openai-web"
  /// JSON array of {title,url} public sources used for live research.
  /// Null for curated questions or when research was unavailable.
  researchSources String?
  sortOrder  Int        @default(0) // stable ordering within a category
  /// JSON ExecSpec for the practice codepad: per-language starter code + test
  /// harness (see src/lib/exec/types.ts). Null = no runnable practice mode.
  /// Harnesses stay server-side; only starter code is sent to the browser.
  execSpec   String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  testCases  TestCase[]

  @@index([companyId])
  @@map("questions")
}

/// Example test cases for a question (input -> expected output), always visible.
model TestCase {
  id          String   @id @default(cuid())
  questionId  String
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  input       String
  expected    String
  explanation String?
  isHidden    Boolean  @default(false) // reserved for future hidden cases / autograding
  sortOrder   Int      @default(0)

  @@index([questionId])
  @@map("test_cases")
}
