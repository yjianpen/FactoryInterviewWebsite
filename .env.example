# Copy to .env and fill in. .env is gitignored; this example is committed.

# PostgreSQL connection string. Use Neon/Vercel Postgres for local and hosted runs.
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# Leave OPENAI_API_KEY empty to use built-in curated questions (no key needed).
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
# Model used for current public interview-report research before generation.
OPENAI_RESEARCH_MODEL="gpt-4.1"
# Set false to skip live research and use only the company profile.
OPENAI_WEB_RESEARCH="true"
MAX_RESEARCH_CHARS="16000"

# auto | openai | curated
QUESTION_PROVIDER="auto"

# CodePad. Local development enables it by default; production defaults to off.
# Execution target is chosen automatically:
#   - Vercel: runs in an isolated Vercel Sandbox microVM (needs the @vercel/sandbox
#     dependency and Vercel OIDC auth, which production provides automatically)
#   - elsewhere: spawns local Python/C++/Java toolchains with the server user's OS
#     permissions, so do not enable that path for untrusted users.
# Set CODE_EXECUTION_ENABLED=true on Vercel to turn the CodePad on there.
CODE_EXECUTION_ENABLED="true"
RUN_TIMEOUT_MS="8000"
MAX_RUN_OUTPUT_CHARS="64000"
# Required on Vercel for C++ and Java: a Vercel Sandbox snapshot containing
# g++ and a JDK. Create one with `node scripts/build-toolchain-snapshot.mjs`.
SANDBOX_TOOLCHAIN_SNAPSHOT_ID=""
