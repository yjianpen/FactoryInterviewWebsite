# Copy to .env and fill in. .env is gitignored; this example is committed.

DATABASE_URL="file:./dev.db"

# Leave OPENAI_API_KEY empty to use built-in curated questions (no key needed).
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
# Model used for current public interview-report research before generation.
OPENAI_RESEARCH_MODEL="gpt-4.1"
# Set false to skip live research and use only the company profile.
OPENAI_WEB_RESEARCH="true"
MAX_RESEARCH_CHARS="16000"

# auto | openai | curated
QUESTION_PROVIDER="auto"

# CodePad. The local development default is enabled; production defaults to off.
# Submitted Python runs with the server user's OS permissions, so do not enable
# this for untrusted users without adding a real sandbox.
CODE_EXECUTION_ENABLED="true"
RUN_TIMEOUT_MS="8000"
MAX_RUN_OUTPUT_CHARS="64000"
